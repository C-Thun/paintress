{
  "name": "paintress",
  "version": "0.1.0",
  "description": "Design-document operation layer for AI agents: read, query, edit, render",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js"
    }
  },
  "bin": {
    "paintress": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && pnpm --dir ui build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build:server": "tsdown",
    "build:ui": "pnpm --dir ui build",
    "dev:ui": "pnpm --dir ui dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^6.0.0",
    "lucide-static": "^1.70.0",
    "playwright-core": "^1.65.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "js-yaml": "^4.1.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
